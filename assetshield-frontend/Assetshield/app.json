{
  "expo": {
    "name": "Assetshield",
    "slug": "Assetshield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "assetshield",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F1",
        "foregroundImage": "./assets/images/adaptive-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.assetshield"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-emblem.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F1",
          "dark": {
            "backgroundColor": "#F6F5F1"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "AssetShield uses your camera to photograph assets and damage as tamper-evident evidence.",
          "photosPermission": "AssetShield needs photo access to attach images of your assets and damage."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AssetShield tags evidence with your location so photos can be paired automatically."
        }
      ],
      "expo-notifications",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f26cc43-4506-40aa-947c-c8af631eb620"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1f26cc43-4506-40aa-947c-c8af631eb620"
    }
  }
}
