# ── AssetShield GH — environment template ──────────────────────────────────
# Copy to .env and fill in real values. The real .env is git-ignored.
# Services FAIL FAST at startup if JWT_SECRET or their DB password is missing.

# PostgreSQL superuser (container bootstrap only; services never use it)
POSTGRES_PASSWORD=change-me-postgres-superuser

# Per-service database passwords (each service can reach ONLY its own database)
AUTH_DB_PASSWORD=change-me-auth
PROPERTY_DB_PASSWORD=change-me-property
DAMAGE_DB_PASSWORD=change-me-damage
MARKETPLACE_DB_PASSWORD=change-me-marketplace
NOTIFICATION_DB_PASSWORD=change-me-notification

# HS256 signing secret shared by gateway (edge validation) and auth-service
# (issuance). MUST be at least 64 characters of high-entropy material.
JWT_SECRET=change-me-to-a-random-string-of-at-least-64-characters-aaaaaaaaaaaaaaaa

# Shared key for service-to-service calls on the internal Docker network
INTERNAL_API_KEY=change-me-internal-api-key

# Aggregated Swagger UI at the gateway (/swagger-ui.html, dev convenience).
# "true" (default) serves the five-service docs dropdown; set "false" in ANY
# public deployment — the gateway then 404s every doc path.
SWAGGER_ENABLED=true

# Superadmin seeded at auth-service startup (idempotent; only when no ACTIVE
# ADMIN exists). Plaintext here, BCrypt-hashed at seed time, never logged.
SUPERADMIN_PHONE=+233200000000
SUPERADMIN_PASSWORD=change-me-superadmin

# SMS provider: only "mock" is implemented today (logs OTP codes at INFO)
SMS_PROVIDER=mock

# Dev/demo convenience: when set, this fixed code is accepted as a valid OTP
# for any phone in addition to the real code. Leave EMPTY in production.
OTP_DEV_CODE=123456

# ── NOTE: the database is INTERNAL to the Docker stack ─────────────────────
# The *_DB_PASSWORD vars above are for the bundled PostgreSQL container, which
# ships WITH the backend in every deployment. There is no external/managed
# database — not Supabase Postgres, nothing. Supabase below is storage-only;
# Firebase below is FCM-only.

# ── Storage: object files (property photos, receipts, Ghana Cards, dossiers) ─
# "local"    — offline fallback: objects on the storage-data volume, downloads
#              served as short-lived token URLs (/api/v1/public/files/{token}).
#              The default; needs no external service or internet.
# "supabase" — Supabase Storage, which is S3-compatible (accessed via the AWS
#              S3 SDK). A single PRIVATE bucket; reads are presigned GET URLs.
#              See PROVIDER_SETUP.md to create the project, a private bucket and
#              the S3 access keys, and to read off the endpoint + region.
STORAGE_PROVIDER=local
SUPABASE_S3_ENDPOINT=          # e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=            # shown per project in the Supabase dashboard, e.g. us-east-1
SUPABASE_S3_ACCESS_KEY_ID=     # Supabase → Storage → S3 access keys
SUPABASE_S3_SECRET_ACCESS_KEY= # shown once when the access key is created
SUPABASE_STORAGE_BUCKET=assetshield  # the private bucket name

# ── Push notifications (FCM-only Firebase) ─────────────────────────────────
# "log"      — pushes printed by notification-service (default demo; the in-app
#              history and tips feed work fully without FCM).
# "firebase" — real FCM. Put the FCM service-account JSON at
#              infra/firebase/firebase-service-account.json (mounted read-only
#              at /secrets). This Firebase project is used for FCM ONLY — no
#              Firebase Storage, no storage bucket.
FCM_MODE=log
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json

# ── Cross-service modes ────────────────────────────────────────────────────
# Tier lookups: "remote" (Day 5+) asks marketplace-service for the live tier;
# "stub" serves STUB_TIER to everyone (FREE exercises the limits: 1 property,
# 30 photos per property).
TIER_LOOKUP_MODE=remote
STUB_TIER=PRO
# Opt-in pushes to marketplace: "remote" (Day 5+) or "log"
MARKETPLACE_EVENTS_MODE=remote
# Notifications + domain events: "remote" (Day 6+) sends them to
# notification-service; "log" prints them (offline / partial stack)
NOTIFICATIONS_MODE=remote
EVENTS_MODE=remote

# ── Damage service (Day 3) ─────────────────────────────────────────────────
# GPS radius (metres) for automatic before/after pairing suggestions
PAIRING_RADIUS_METERS=25

# ── Payments + dossiers (Day 4) ────────────────────────────────────────────
# "mock"     — offline demo: initialize returns a fake checkout URL and the
#              payment auto-settles after ~2s, so the dossier flow runs with
#              zero internet.
# "paystack" — real checkout against api.paystack.co. Set your TEST secret key
#              (sk_test_...). Locally, webhooks can't reach you — after paying
#              call POST /api/v1/payments/{reference}/verify (the client's
#              normal post-checkout path), or run a tunnel (ngrok etc.) and
#              point the Paystack dashboard webhook at
#              https://<tunnel>/api/v1/payments/webhook.
PAYMENTS_MODE=mock
PAYSTACK_SECRET_KEY=
# Dossier fee charged per generated dossier (GHS)
DOSSIER_FEE_GHS=50.00
# mock mode only: auto-settle delay in ms (simulates instant MoMo). <0 disables
# auto-settle so tests can drive the webhook explicitly. Default 2000.
MOCK_AUTO_SETTLE_MS=2000

# ── Marketplace (Day 5) ────────────────────────────────────────────────────
# Monthly subscription prices (GHS): agents (marketplace access) and owners
# (PRO tier). Settled payments extend the subscription by 30 days.
AGENT_SUB_GHS=100.00
PRO_SUB_GHS=15.00

# ── Tips engine (Day 6) ────────────────────────────────────────────────────
# (FCM_MODE / FIREBASE_SERVICE_ACCOUNT_PATH are in the storage/push section above.)
# Batch size per generation run and the per-property debounce window for
# asset-upload triggers (bulk uploads = one run).
TIPS_BATCH_SIZE=3
TIPS_DEBOUNCE_MINUTES=60
# Scheduler cadences (Spring cron, Africa/Accra). Override for demos, e.g.
# SCHED_TIP_DELIVERY_CRON=0 * * * * * delivers every minute.
SCHED_TIP_DELIVERY_CRON=0 0 7 * * *
SCHED_REDOC_CRON=0 0 9 * * *
REDOC_STALE_DAYS=90
