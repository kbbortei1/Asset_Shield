# Automatic HTTPS for the AssetShield API.
# Caddy fetches + auto-renews a Let's Encrypt cert for this domain and reverse-
# proxies to the gateway container. HTTP (80) auto-redirects to HTTPS (443).
{
	email officialkingbee2@gmail.com
}

api.assetshield.me {
	# Paystack redirects the mobile browser here after payment (its callback_url).
	# We do NOT deep-link back (custom-scheme auto-return was unreliable on
	# Android and dumped users on an "Unmatched Route"). Instead we show a clear
	# "done — go back to the app" page; the app verifies the payment on return
	# and also offers a "Confirm payment" button.
	handle /pay/return* {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Payment received</title></head><body style="font-family:system-ui,sans-serif;text-align:center;padding:72px 24px;color:#11252B"><div style="font-size:56px;line-height:1">✓</div><h2 style="margin:16px 0 8px">Payment received</h2><p style="font-size:16px;color:#4a5a5f;max-width:320px;margin:0 auto">You can close this page and return to AssetShield. Tap <b>Confirm payment</b> in the app to finish.</p></body></html>` 200
	}

	handle {
		reverse_proxy gateway:8080
	}
}
